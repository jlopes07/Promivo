rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserDoc().active == true;
    }

    function isOwner() {
      return isActiveUser() && getUserDoc().role == 'owner';
    }

    function isAdmin() {
      return isOwner() || (isActiveUser() && getUserDoc().role == 'admin');
    }

    function isManager() {
      return isAdmin() || (isActiveUser() && getUserDoc().role == 'manager');
    }

    function isAffiliate() {
      return isManager() || (isActiveUser() && getUserDoc().role == 'affiliate');
    }

    // Offers Collection: Public read, role-scoped write
    match /offers/{offerId} {
      allow read: if true;
      allow create: if isAffiliate();
      allow update, delete: if isManager() || (isAffiliate() && resource.data.createdBy == request.auth.uid);
    }

    // Categories Collection: Public read, Manager write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Products Collection: Public read, Manager write
    match /products/{productId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Users Collection: User reads own record, Admin reads/writes all (Owner protection enforced via Functions)
    match /users/{userId} {
      allow read: if isActiveUser() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Settings Collection: Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Logs Collection: Manager read, active user write
    match /logs/{logId} {
      allow read: if isManager();
      allow create: if isActiveUser();
    }
  }
}
